<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Тема без анимаций: на экране из электронных чернил каждый переход и
      затухание оплачиваются полной перерисовкой, а выглядят как смазанный
      след. Поэтому выключены и оконные переходы, и системная анимация.
    -->
    <style name="Theme.Memora" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>
</resources>
