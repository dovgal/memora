{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT s.id, s.title, s.description, s.created_at, s.fields_schema, COUNT(f.id) as flashcard_count\n        FROM sets s\n        LEFT JOIN flashcards f ON s.id = f.set_id\n        WHERE s.creator_id = $1\n        GROUP BY s.id\n        ORDER BY s.created_at DESC\n        ",
