{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT f.id, f.name, f.description, f.created_at, COUNT(fs.set_id) as set_count\n        FROM folders f\n        LEFT JOIN folder_sets fs ON f.id = fs.folder_id\n        WHERE f.user_id = $1\n        GROUP BY f.id\n        ORDER BY f.created_at DESC\n        ",
