{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "nixpacksPlan": {
            "variables": {
                "SQLX_OFFLINE": "true"
            }
        }
    },
    "deploy": {
        "startCommand": "cargo run --release",
        "numReplicas": 1
    }
}