# Скопируйте в .env и заполните. .env игнорируется git — секреты в репозиторий не попадают.

# Postgres (локально: docker-compose up)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/memora

# Секрет подписи JWT (должен совпадать с NEXTAUTH_SECRET фронтенда)
NEXTAUTH_SECRET=change-me

# --- LLM ---
# Основной провайдер. Вариант А (по умолчанию): нативный Ollama.
OLLAMA_BASE_URL=https://ollama.com/api/chat
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b

# Вариант Б: любой OpenAI-совместимый провайдер (перекрывает вариант А, если задан).
# LLM_BASE_URL=https://ollama.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-oss:120b
# Переопределение модели по назначению вызова (опционально):
# LLM_MODEL_GENERATION=
# LLM_MODEL_GRADING=
# LLM_MODEL_CHAT=
# Резервный OpenAI-совместимый провайдер (опционально):
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=
# Аварийное отключение structured outputs: LLM_STRUCTURED_OUTPUTS=0

# Inworld TTS (озвучка). Формат: "Basic <base64 key>"
INWORLD_AUTH=
