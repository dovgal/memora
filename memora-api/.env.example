# Скопируйте в .env и заполните. .env игнорируется git — секреты в репозиторий не попадают.

# Postgres (локально: docker-compose up)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/memora

# Секрет подписи JWT (должен совпадать с NEXTAUTH_SECRET фронтенда)
NEXTAUTH_SECRET=change-me

# Allowlist регистрации: email через запятую. Если задан — создавать аккаунты
# (по паролю И через Google SSO) могут только эти адреса; иначе регистрация открыта.
# REGISTRATION_ALLOWLIST=mom@family.com,dad@family.com,kid@family.com

# Разрешённые CORS-origin (через запятую). По умолчанию: прод-фронтенд + localhost:3000.
# FRONTEND_ORIGINS=https://memora-web-production.up.railway.app,http://localhost:3000

# --- LLM ---
# Основной провайдер. Вариант А (по умолчанию): нативный Ollama.
OLLAMA_BASE_URL=https://ollama.com/api/chat
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b

# Вариант Б: любой OpenAI-совместимый провайдер (перекрывает вариант А, если задан).
# LLM_BASE_URL=https://ollama.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-oss:120b
# Переопределение модели по назначению вызова (опционально):
# LLM_MODEL_GENERATION=
# LLM_MODEL_GRADING=
# LLM_MODEL_CHAT=
# Резервный OpenAI-совместимый провайдер (опционально):
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=
# Аварийное отключение structured outputs: LLM_STRUCTURED_OUTPUTS=0

# Inworld TTS (озвучка). Формат: "Basic <base64 key>"
INWORLD_AUTH=

# --- CAS-сервис (memora-math, SymPy): symbolic-проверка + верификация numeric-вариантов ---
# Без него symbolic отвечает 503, варианты numeric-задач не генерируются.
# MATH_SERVICE_URL=http://memora-math.railway.internal:8080
# MATH_SERVICE_TOKEN=

# --- Web Push напоминания (пуши без payload, текст в service worker) ---
# Генерация ключей:
#   openssl ecparam -genkey -name prime256v1 | openssl pkcs8 -topk8 -nocrypt -out vapid.pem
#   openssl ec -in vapid.pem -pubout -outform DER | tail -c 65 | basenc --base64url | tr -d '=\n'
# VAPID_PUBLIC_KEY=   # base64url несжатой точки (вторая команда)
# VAPID_PRIVATE_PEM=  # содержимое vapid.pem (переводы строк можно как \n)
# VAPID_SUBJECT=mailto:you@example.com
# PUSH_REMINDER_HOUR=18   # локальный час напоминания (по умолчанию 18)

# --- Фоновая прегенерация вариантов упражнений ---
# VARIANT_PREGEN=0             # выключить воркер
# VARIANT_PREGEN_INTERVAL_MIN= # период проходов, мин (по умолчанию 60)
# VARIANT_PREGEN_BATCH=        # максимум генераций за проход (по умолчанию 20)
