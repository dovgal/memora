    {
      "id": "u11-theory-1",
      "type": "theory",
      "title": "Le logement — Жильё по-французски",
      "content": "<p style='margin:0.75rem 0'>Главные слова для разговора о жилье:</p><table style='width:100%;border-collapse:collapse;margin:1rem 0'><tr><th style='text-align:left;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.2)'>Слово</th><th style='text-align:left;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.2)'>Перевод</th><th style='text-align:left;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.2)'>Пример</th></tr><tr><td style='padding:0.5rem;color:#60a5fa;font-weight:bold'>un studio</td><td style='padding:0.5rem'>студия</td><td style='padding:0.5rem'>Je loue un studio de 25 m².</td></tr><tr><td style='padding:0.5rem;color:#60a5fa;font-weight:bold'>un deux-pièces</td><td style='padding:0.5rem'>двухкомнатная</td><td style='padding:0.5rem'>C'est un deux-pièces avec balcon.</td></tr><tr><td style='padding:0.5rem;color:#60a5fa;font-weight:bold'>le rez-de-chaussée</td><td style='padding:0.5rem'>первый этаж</td><td style='padding:0.5rem'>J'habite au rez-de-chaussée.</td></tr><tr><td style='padding:0.5rem;color:#60a5fa;font-weight:bold'>le premier étage</td><td style='padding:0.5rem'>второй этаж (!)</td><td style='padding:0.5rem'>Ma chambre est au premier étage.</td></tr><tr><td style='padding:0.5rem;color:#60a5fa;font-weight:bold'>meublé / vide</td><td style='padding:0.5rem'>с мебелью / без</td><td style='padding:0.5rem'>Un appartement meublé.</td></tr></table><p style='margin:0.75rem 0;padding:0.6rem 0.8rem;border-left:3px solid #fbbf24;background:rgba(251,191,36,0.08)'>💡 Французский «premier étage» — это наш <b>второй</b> этаж! Наш первый — le rez-de-chaussée.</p>"
    },
    {
      "id": "u11-theory-2",
      "type": "theory",
      "title": "Les prépositions de lieu (2) — Где стоит мебель?",
      "content": "<p style='margin:0.75rem 0'>Чтобы сказать, где находится предмет:</p><table style='width:100%;border-collapse:collapse;margin:1rem 0'><tr><th style='text-align:left;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.2)'>Предлог</th><th style='text-align:left;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.2)'>Значение</th><th style='text-align:left;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.2)'>Пример</th></tr><tr><td style='padding:0.5rem;color:#60a5fa;font-weight:bold'>sur</td><td style='padding:0.5rem'>на</td><td style='padding:0.5rem'>Le livre est sur la table.</td></tr><tr><td style='padding:0.5rem;color:#60a5fa;font-weight:bold'>sous</td><td style='padding:0.5rem'>под</td><td style='padding:0.5rem'>Le chat dort sous le lit.</td></tr><tr><td style='padding:0.5rem;color:#60a5fa;font-weight:bold'>dans</td><td style='padding:0.5rem'>в</td><td style='padding:0.5rem'>Les assiettes sont dans l'armoire.</td></tr><tr><td style='padding:0.5rem;color:#60a5fa;font-weight:bold'>devant</td><td style='padding:0.5rem'>перед</td><td style='padding:0.5rem'>Il y a un tapis devant le canapé.</td></tr><tr><td style='padding:0.5rem;color:#60a5fa;font-weight:bold'>derrière</td><td style='padding:0.5rem'>за</td><td style='padding:0.5rem'>La lampe est derrière le fauteuil.</td></tr><tr><td style='padding:0.5rem;color:#60a5fa;font-weight:bold'>entre</td><td style='padding:0.5rem'>между</td><td style='padding:0.5rem'>La table est entre les chaises.</td></tr><tr><td style='padding:0.5rem;color:#60a5fa;font-weight:bold'>à côté de</td><td style='padding:0.5rem'>рядом с</td><td style='padding:0.5rem'>Le frigo est à côté de l'évier.</td></tr><tr><td style='padding:0.5rem;color:#60a5fa;font-weight:bold'>en face de</td><td style='padding:0.5rem'>напротив</td><td style='padding:0.5rem'>La télé est en face du canapé.</td></tr></table><p style='margin:0.75rem 0;padding:0.6rem 0.8rem;border-left:3px solid #fbbf24;background:rgba(251,191,36,0.08)'>💡 de + le = <b>du</b>: en face <b>du</b> canapé. de + les = <b>des</b>: à côté <b>des</b> fenêtres.</p>"
    },
