  "exercises": [
    {
      "id": "a2u4-th1",
      "type": "theory",
      "title": "Chaque, tout, toute, tous, toutes",
      "content": "<table style='width:100%;border-collapse:collapse;margin:1rem 0'><tr><th style='text-align:left;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.2)'>Форма</th><th style='text-align:left;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.2)'>Употребление</th><th style='text-align:left;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.2)'>Пример</th></tr><tr><td style='padding:0.5rem;color:#60a5fa;font-weight:bold'>chaque + ед.ч.</td><td style='padding:0.5rem'>каждый</td><td style='padding:0.5rem'>Chaque personne est différente.</td></tr><tr><td style='padding:0.5rem;color:#60a5fa;font-weight:bold'>tout + м.р. ед.</td><td style='padding:0.5rem'>весь</td><td style='padding:0.5rem'>tout le monde (все)</td></tr><tr><td style='padding:0.5rem;color:#60a5fa;font-weight:bold'>toute + ж.р. ед.</td><td style='padding:0.5rem'>вся</td><td style='padding:0.5rem'>toute la famille</td></tr><tr><td style='padding:0.5rem;color:#60a5fa;font-weight:bold'>tous + м.р. мн.</td><td style='padding:0.5rem'>все</td><td style='padding:0.5rem'>tous mes amis</td></tr><tr><td style='padding:0.5rem;color:#60a5fa;font-weight:bold'>toutes + ж.р. мн.</td><td style='padding:0.5rem'>все</td><td style='padding:0.5rem'>toutes les qualités</td></tr></table><p style='margin:0.75rem 0;padding:0.6rem 0.8rem;border-left:3px solid #fbbf24;background:rgba(251,191,36,0.08)'>💡 Tout le monde = «все», но глагол в единственном числе: <i>Tout le monde est là.</i></p>"
    },
    {
      "id": "a2u4-qz1",
      "type": "grammar-quiz",
      "title": "Tout / chaque — практика",
      "questions": [
        {
          "question": "___ mes amis sont différents.",
          "options": [
            "Tous",
            "Tout",
            "Toute",
            "Chaque"
          ],
          "correctAnswer": "Tous",
          "explanation": "Mes amis — м.р. мн.ч.: tous."
        },
        {
          "question": "___ personne a des qualités et des défauts.",
          "options": [
            "Chaque",
            "Tous",
            "Tout",
            "Toutes"
          ],
          "correctAnswer": "Chaque",
          "explanation": "«Каждый человек» — chaque + единственное число."
        },
        {
          "question": "Elle sourit ___ la journée.",
          "options": [
            "toute",
            "tout",
            "tous",
            "toutes"
          ],
          "correctAnswer": "toute",
          "explanation": "La journée — ж.р. ед.ч.: toute la journée."
        },
        {
          "question": "___ le monde aime les compliments.",
          "options": [
            "Tout",
            "Tous",
            "Toute",
            "Chaque"
          ],
          "correctAnswer": "Tout",
          "explanation": "Устойчивое tout le monde + глагол в ед. числе."
        }
      ]
    },
    {
      "id": "a2u4-th2",
      "type": "theory",
      "title": "Les pronoms possessifs — le mien, la tienne...",
      "content": "<p style='margin:0.75rem 0'>Чтобы не повторять существительное: «мой, твой, его...» как самостоятельное слово:</p><table style='width:100%;border-collapse:collapse;margin:1rem 0'><tr><th style='text-align:left;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.2)'></th><th style='text-align:left;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.2)'>м.р. ед.</th><th style='text-align:left;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.2)'>ж.р. ед.</th><th style='text-align:left;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.2)'>мн. число</th></tr><tr><td style='padding:0.5rem'>мой</td><td style='padding:0.5rem'>le mien</td><td style='padding:0.5rem'>la mienne</td><td style='padding:0.5rem'>les miens / les miennes</td></tr><tr><td style='padding:0.5rem'>твой</td><td style='padding:0.5rem'>le tien</td><td style='padding:0.5rem'>la tienne</td><td style='padding:0.5rem'>les tiens / les tiennes</td></tr><tr><td style='padding:0.5rem'>его/её</td><td style='padding:0.5rem'>le sien</td><td style='padding:0.5rem'>la sienne</td><td style='padding:0.5rem'>les siens / les siennes</td></tr><tr><td style='padding:0.5rem'>наш</td><td style='padding:0.5rem'>le nôtre</td><td style='padding:0.5rem'>la nôtre</td><td style='padding:0.5rem'>les nôtres</td></tr><tr><td style='padding:0.5rem'>ваш</td><td style='padding:0.5rem'>le vôtre</td><td style='padding:0.5rem'>la vôtre</td><td style='padding:0.5rem'>les vôtres</td></tr><tr><td style='padding:0.5rem'>их</td><td style='padding:0.5rem'>le leur</td><td style='padding:0.5rem'>la leur</td><td style='padding:0.5rem'>les leurs</td></tr></table><p style='margin:0.75rem 0;padding:0.6rem 0.8rem;border-left:3px solid #fbbf24;background:rgba(251,191,36,0.08)'>💡 Род — по заменяемому слову: <i>Ta veste est belle, la mienne est vieille.</i></p>"
    },
