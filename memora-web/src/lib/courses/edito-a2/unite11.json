    {
      "id": "a2u11-th1",
      "type": "theory",
      "title": "Le discours rapporté au présent — косвенная речь",
      "content": "<p style='margin:0.75rem 0'>Передаём чужие слова без кавычек:</p><table style='width:100%;border-collapse:collapse;margin:1rem 0'><tr><th style='text-align:left;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.2)'>Прямая речь</th><th style='text-align:left;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.2)'>Косвенная речь</th></tr><tr><td style='padding:0.5rem'>Il dit : « Je cherche un stage. »</td><td style='padding:0.5rem'>Il dit qu'il cherche un stage.</td></tr><tr><td style='padding:0.5rem'>Elle demande : « Tu es libre ? »</td><td style='padding:0.5rem'>Elle demande si tu es libre.</td></tr><tr><td style='padding:0.5rem'>Il demande : « Qu'est-ce que tu fais ? »</td><td style='padding:0.5rem'>Il demande ce que tu fais.</td></tr><tr><td style='padding:0.5rem'>Elle dit : « Envoyez votre CV ! »</td><td style='padding:0.5rem'>Elle dit d'envoyer votre CV.</td></tr></table><p style='margin:0.75rem 0;padding:0.6rem 0.8rem;border-left:3px solid #fbbf24;background:rgba(251,191,36,0.08)'>💡 Вопрос «да/нет» → <b>si</b>; qu'est-ce que → <b>ce que</b>; приказ → <b>de + инфинитив</b>.</p>"
    },
    {
      "id": "a2u11-qz1",
      "type": "grammar-quiz",
      "title": "Косвенная речь — практика",
      "questions": [
        {
          "question": "Le recruteur demande ___ vous avez de l'expérience.",
          "options": [
            "si",
            "que",
            "ce que",
            "quoi"
          ],
          "correctAnswer": "si",
          "explanation": "Вопрос «да/нет» в косвенной речи — si."
        },
        {
          "question": "Elle dit ___ elle prépare un diplôme de commerce.",
          "options": [
            "qu'",
            "si",
            "ce qu'",
            "de"
          ],
          "correctAnswer": "qu'",
          "explanation": "Утверждение — que (qu' перед гласной)."
        },
        {
          "question": "Il me demande ___ je fais comme études.",
          "options": [
            "ce que",
            "que",
            "si",
            "quel"
          ],
          "correctAnswer": "ce que",
          "explanation": "Qu'est-ce que tu fais ? → ce que je fais."
        },
        {
          "question": "Le professeur nous dit ___ envoyer le dossier avant lundi.",
          "options": [
            "d'",
            "que",
            "si",
            "à"
          ],
          "correctAnswer": "d'",
          "explanation": "Приказ/просьба → dire de + инфинитив."
        }
      ]
    },
    {
      "id": "a2u11-th2",
      "type": "theory",
      "title": "Le message formel — официальное письмо",
      "content": "<p style='margin:0.75rem 0'>Каркас формального письма (кандидатура, запрос):</p><table style='width:100%;border-collapse:collapse;margin:1rem 0'><tr><th style='text-align:left;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.2)'>Часть</th><th style='text-align:left;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.2)'>Формулы</th></tr><tr><td style='padding:0.5rem'>обращение</td><td style='padding:0.5rem'>Madame, Monsieur,</td></tr><tr><td style='padding:0.5rem'>цель</td><td style='padding:0.5rem'>Je vous écris au sujet de... / Je suis intéressé(e) par...</td></tr><tr><td style='padding:0.5rem'>о себе</td><td style='padding:0.5rem'>Actuellement étudiant(e) en..., je cherche un stage...</td></tr><tr><td style='padding:0.5rem'>просьба</td><td style='padding:0.5rem'>Je voudrais savoir si... / Pourriez-vous me dire...</td></tr><tr><td style='padding:0.5rem'>благодарность</td><td style='padding:0.5rem'>Je vous remercie de votre attention.</td></tr><tr><td style='padding:0.5rem'>прощание</td><td style='padding:0.5rem'>Cordialement, / Sincères salutations,</td></tr></table><p style='margin:0.75rem 0;padding:0.6rem 0.8rem;border-left:3px solid #fbbf24;background:rgba(251,191,36,0.08)'>💡 В формальном письме всегда <b>vous</b>; никаких «Salut» и «Bises» — это для друзей!</p>"
    },
