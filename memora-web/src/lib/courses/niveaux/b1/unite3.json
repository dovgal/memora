    {
      "id": "b1u3-th2",
      "type": "theory",
      "title": "Cause et conséquence — причина и следствие",
      "content": "<table style='width:100%;border-collapse:collapse;margin:1rem 0'><tr><th style='text-align:left;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.2)'>Причина</th><th style='text-align:left;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.2)'>Пример</th></tr><tr><td style='padding:0.5rem'>parce que (ответ на pourquoi)</td><td style='padding:0.5rem'>Je reste parce que je suis fatigué.</td></tr><tr><td style='padding:0.5rem'>comme (в начале фразы)</td><td style='padding:0.5rem'>Comme il pleuvait, on est restés.</td></tr><tr><td style='padding:0.5rem'>puisque (очевидная причина)</td><td style='padding:0.5rem'>Puisque tu es là, aide-moi !</td></tr><tr><td style='padding:0.5rem'>grâce à (позитив)</td><td style='padding:0.5rem'>J'ai réussi grâce à tes conseils.</td></tr><tr><td style='padding:0.5rem'>à cause de (негатив)</td><td style='padding:0.5rem'>Le match est annulé à cause de l'orage.</td></tr></table><table style='width:100%;border-collapse:collapse;margin:1rem 0'><tr><th style='text-align:left;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.2)'>Следствие</th><th style='text-align:left;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.2)'>Пример</th></tr><tr><td style='padding:0.5rem'>donc</td><td style='padding:0.5rem'>Il est tard, donc je rentre.</td></tr><tr><td style='padding:0.5rem'>alors</td><td style='padding:0.5rem'>Je m'ennuyais, alors je suis parti.</td></tr><tr><td style='padding:0.5rem'>c'est pourquoi</td><td style='padding:0.5rem'>Il neige, c'est pourquoi le bus est en retard.</td></tr><tr><td style='padding:0.5rem'>si bien que</td><td style='padding:0.5rem'>Il a plu si bien que la rue est inondée.</td></tr><tr><td style='padding:0.5rem'>tellement... que</td><td style='padding:0.5rem'>Il parle tellement vite qu'on ne comprend rien.</td></tr></table>"
    },
