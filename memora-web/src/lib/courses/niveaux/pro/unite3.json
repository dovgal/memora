      "title": "Договоры и зарплата — практика",
      "questions": [
        {
          "question": "«Бессрочный трудовой договор» — это…",
          "options": [
            "un CDI",
            "un CDD",
            "un avenant",
            "une mutuelle"
          ],
          "correctAnswer": "un CDI",
          "explanation": "CDI — contrat à durée indéterminée (бессрочный)."
        },
        {
          "question": "«Расторжение по соглашению сторон» — это…",
          "options": [
            "la rupture conventionnelle",
            "le licenciement",
            "la démission",
            "le préavis"
          ],
          "correctAnswer": "la rupture conventionnelle",
          "explanation": "Rupture conventionnelle — обоюдное согласие (не démission и не licenciement)."
        },
        {
          "question": "В расчётном листке сумма «на руки» — это…",
          "options": [
            "le salaire net",
            "le salaire brut",
            "la prime",
            "la mutuelle"
          ],
          "correctAnswer": "le salaire net",
          "explanation": "Net — после вычетов; brut — до вычетов."
        },
        {
          "question": "«Дополнительное соглашение к договору» — это…",
          "options": [
            "un avenant",
            "un CDD",
            "un préavis",
            "un coefficient"
          ],
          "correctAnswer": "un avenant",
          "explanation": "Avenant изменяет условия действующего договора (например, часы или должность)."
        },
        {
          "question": "«Корпоративная медицинская страховка» — это…",
          "options": [
            "la mutuelle",
            "la prévoyance",
            "la prime",
            "les congés payés"
          ],
          "correctAnswer": "la mutuelle",
          "explanation": "Mutuelle — медстраховка; prévoyance покрывает нетрудоспособность/риски."
        }
      ]
    }
