        {
          "question": "Tu fais confiance à tes collègues ? — Oui, je ___ fais confiance.",
          "options": [
            "leur",
            "les",
            "y",
            "en"
          ],
          "correctAnswer": "leur",
          "explanation": "Faire confiance à + люди → leur."
        },
        {
          "question": "Ce style plaît ___ jeunes.",
          "options": [
            "aux",
            "les",
            "des",
            "pour les"
          ],
          "correctAnswer": "aux",
          "explanation": "Plaire à: à + les = aux jeunes."
        },
        {
          "question": "Tu t'es habitué au climat ? — Oui, je m'___ suis habitué.",
          "options": [
            "y",
            "le",
            "lui",
            "en"
          ],
          "correctAnswer": "y",
          "explanation": "S'habituer à + вещь → y: je m'y suis habitué."
        }
      ]
    },
