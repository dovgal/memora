  "exercises": [
    {
      "id": "vb2-th1",
      "type": "theory",
      "title": "Семья глаголов с à",
      "content": "<p style='margin:0.75rem 0'>Предлог à обычно вводит адресата или точку приложения. Полезно учить группами:</p><table style='width:100%;border-collapse:collapse;margin:1rem 0'><tr><th style='text-align:left;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.2)'>Группа</th><th style='text-align:left;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.2)'>Глаголы</th><th style='text-align:left;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.2)'>Пример</th></tr><tr><td style='padding:0.5rem'>мысль</td><td style='padding:0.5rem'>penser à, réfléchir à, songer à</td><td style='padding:0.5rem'>Je pense à mes vacances.</td></tr><tr><td style='padding:0.5rem'>участие</td><td style='padding:0.5rem'>participer à, assister à, jouer à</td><td style='padding:0.5rem'>Elle participe au concours.</td></tr><tr><td style='padding:0.5rem'>отношение к людям</td><td style='padding:0.5rem'>plaire à, obéir à, ressembler à, faire confiance à</td><td style='padding:0.5rem'>Tu ressembles à ton père.</td></tr><tr><td style='padding:0.5rem'>достижение/отказ</td><td style='padding:0.5rem'>réussir à, parvenir à, renoncer à</td><td style='padding:0.5rem'>Il a réussi à l'examen.</td></tr><tr><td style='padding:0.5rem'>принадлежность</td><td style='padding:0.5rem'>appartenir à</td><td style='padding:0.5rem'>Ce livre appartient à Marie.</td></tr><tr><td style='padding:0.5rem'>привычка/привязанность</td><td style='padding:0.5rem'>s'habituer à, tenir à</td><td style='padding:0.5rem'>Je tiens à cette photo.</td></tr></table><p style='margin:0.75rem 0;padding:0.6rem 0.8rem;border-left:3px solid #fbbf24;background:rgba(251,191,36,0.08)'>💡 Замена местоимением: люди → <b>lui/leur</b> (je lui obéis), вещи/идеи → <b>y</b> (j'y pense). Но penser à + человек — ударная форма: je pense à LUI!</p>"
    },
    {
      "id": "vb2-qz1",
      "type": "grammar-quiz",
      "title": "Verbes + à — практика",
      "questions": [
        {
          "question": "Elle ___ beaucoup ___ son grand-père.",
          "options": [
            "ressemble ... à",
            "ressemble ... de",
            "ressemble ... avec",
            "ressemble ... sur"
          ],
          "correctAnswer": "ressemble ... à",
          "explanation": "Ressembler À qn — быть похожим НА (по-французски «к»)."
        },
        {
          "question": "Tu as répondu ___ sa lettre ?",
          "options": [
            "à",
            "de",
            "sur",
            "pour"
          ],
          "correctAnswer": "à",
          "explanation": "Répondre À qch — отвечать НА письмо."
        },
        {
          "question": "Ce chien n'___ qu'à son maître.",
          "options": [
            "obéit",
            "obéit que de",
            "écoute à",
            "entend à"
          ],
          "correctAnswer": "obéit",
          "explanation": "Obéir à qn: n'obéit qu'à son maître — слушается только хозяина."
        },
        {
          "question": "Nous avons assisté ___ un concert magnifique.",
          "options": [
            "à",
            "de",
            "dans",
            "chez"
          ],
          "correctAnswer": "à",
          "explanation": "Assister À — присутствовать на."
        },
        {
          "question": "Il a renoncé ___ son projet de tour du monde.",
          "options": [
            "à",
            "de",
            "pour",
            "sur"
          ],
          "correctAnswer": "à",
          "explanation": "Renoncer À qch — отказаться от (внимание: по-русски «от», по-французски à!)."
        },
        {
          "question": "Tes clés ? Je n'y ai pas touché ! — y заменяет…",
          "options": [
            "à tes clés",
            "de tes clés",
            "tes clés (COD)",
            "chez toi"
          ],
          "correctAnswer": "à tes clés",
          "explanation": "Toucher À qch → y: je n'y ai pas touché."
        }
      ]
    },
    {
      "id": "vb2-qz2",
      "type": "grammar-quiz",
      "title": "Местоимения lui/leur/y",
      "questions": [
        {
          "question": "Tu penses à ton examen ? — Oui, j'___ pense jour et nuit.",
          "options": [
            "y",
            "lui",
            "le",
            "en"
          ],
          "correctAnswer": "y",
          "explanation": "Penser à + вещь → y."
