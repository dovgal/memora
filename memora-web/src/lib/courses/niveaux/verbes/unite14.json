  "exercises": [
    {
      "id": "vb14-th1",
      "type": "theory",
      "title": "Lexique A–D: как заучивать",
      "content": "<p style='margin:0.75rem 0'>Это словарные юниты: оставшиеся глаголы справочника, у которых нет особого предложного управления. Их правило одно — система T/I из юнита 1: <b>T</b> — дополнение без предлога (кого? что?), <b>I</b> — без дополнения, <b>T/I</b> — употребляется обоими способами, «se…» — возвратный.</p><p style='margin:0.75rem 0'><b>Цикл:</b> «⭐ В личный набор» → карточки/заучивание → коуч повторяет по кривой забывания. Тест ниже — выборочная проверка переводов.</p><p style='margin:0.75rem 0;padding:0.6rem 0.8rem;border-left:3px solid #fbbf24;background:rgba(251,191,36,0.08)'>💡 Заучивая, проговаривайте мини-пример: не «casser», а «casser un verre» — разбить стакан.</p>"
    },
    {
      "id": "vb14-qz1",
      "type": "grammar-quiz",
      "title": "Выборочная проверка переводов (A–D)",
      "questions": [
        {
          "question": "«avouer» означает…",
          "options": [
            "признавать(ся)",
            "желать",
            "украшать",
            "зевать"
          ],
          "correctAnswer": "признавать(ся)",
          "explanation": "Avouer (T) — признать: avouer une erreur."
        },
        {
          "question": "«bâtir» означает…",
          "options": [
            "строить",
            "бледнеть",
            "драться",
            "кашлять"
          ],
          "correctAnswer": "строить",
          "explanation": "Bâtir (T): bâtir une maison."
        },
        {
          "question": "«déranger» означает…",
          "options": [
            "беспокоить",
            "украшать",
            "разгружать",
            "удваивать"
          ],
          "correctAnswer": "беспокоить",
          "explanation": "Déranger (T): excusez-moi de vous déranger."
        },
        {
          "question": "«разбивать, ломать» — это…",
          "options": [
            "casser",
            "caresser",
            "chasser",
            "chauffer"
          ],
          "correctAnswer": "casser",
          "explanation": "Casser (T): casser un verre."
        },
        {
          "question": "«décéder» означает…",
          "options": [
            "скончаться",
            "удирать",
            "решать",
            "убирать"
          ],
          "correctAnswer": "скончаться",
          "explanation": "Décéder (I) — официальное «умереть»."
        },
        {
          "question": "«огорчать» — это…",
          "options": [
            "désoler",
            "désirer",
            "dessiner",
            "déduire"
