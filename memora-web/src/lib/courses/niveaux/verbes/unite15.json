  "exercises": [
    {
      "id": "vb15-th1",
      "type": "theory",
      "title": "Lexique E–P: как заучивать",
      "content": "<p style='margin:0.75rem 0'>Это словарные юниты: оставшиеся глаголы справочника, у которых нет особого предложного управления. Их правило одно — система T/I из юнита 1: <b>T</b> — дополнение без предлога (кого? что?), <b>I</b> — без дополнения, <b>T/I</b> — употребляется обоими способами, «se…» — возвратный.</p><p style='margin:0.75rem 0'><b>Цикл:</b> «⭐ В личный набор» → карточки/заучивание → коуч повторяет по кривой забывания. Тест ниже — выборочная проверка переводов.</p><p style='margin:0.75rem 0;padding:0.6rem 0.8rem;border-left:3px solid #fbbf24;background:rgba(251,191,36,0.08)'>💡 Заучивая, проговаривайте мини-пример: не «casser», а «casser un verre» — разбить стакан.</p>"
    },
    {
      "id": "vb15-qz1",
      "type": "grammar-quiz",
      "title": "Выборочная проверка переводов (E–P)",
      "questions": [
        {
          "question": "«effacer» означает…",
          "options": [
            "стирать",
            "взрываться",
            "душить",
            "шутить"
          ],
          "correctAnswer": "стирать",
          "explanation": "Effacer (T): effacer le tableau."
        },
        {
          "question": "«наскучивать, беспокоить» — это…",
          "options": [
            "ennuyer",
            "énumérer",
            "enduire",
            "emballer"
          ],
          "correctAnswer": "ennuyer",
          "explanation": "Ennuyer (T): ça m'ennuie."
        },
        {
          "question": "«étonner» означает…",
          "options": [
            "удивлять",
            "растягивать",
            "гасить",
            "узнавать"
          ],
          "correctAnswer": "удивлять",
          "explanation": "Étonner (T): ça m'étonne !"
        },
        {
          "question": "«худеть» — это…",
          "options": [
            "maigrir",
            "grandir",
            "grossir",
            "mendier"
          ],
          "correctAnswer": "maigrir",
          "explanation": "Maigrir (I): il a maigri de 5 kilos."
        },
        {
          "question": "«lâcher» означает…",
          "options": [
            "отпускать",
            "лизать",
            "оставлять себе",
            "связывать"
          ],
          "correctAnswer": "отпускать",
          "explanation": "Lâcher (T): lâche-moi ! — отпусти!"
        },
        {
          "question": "«занимать» (место, пост) — это…",
          "options": [
            "occuper",
            "opérer",
            "orner",
            "opiner"
          ],
          "correctAnswer": "occuper",
          "explanation": "Occuper (T): occuper un poste."
        }
      ]
    }
  ]
