  "exercises": [
    {
      "id": "vb18-th1",
      "type": "theory",
      "title": "Справочник прилагательных: как учить",
      "content": "<p style='margin:0.75rem 0'>Те же семьи, что у глаголов:</p><table style='width:100%;border-collapse:collapse;margin:1rem 0'><tr><th style='text-align:left;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.2)'>Предлог</th><th style='text-align:left;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.2)'>Типичные прилагательные</th></tr><tr><td style='padding:0.5rem'>à</td><td style='padding:0.5rem'>fidèle, hostile, indifférent, semblable, sensible, utile, contraire, égal, inférieur/supérieur, prêt, attentif, allergique, accro</td></tr><tr><td style='padding:0.5rem'>de</td><td style='padding:0.5rem'>content, fier, sûr, certain, capable, conscient, curieux, différent, digne, fou, heureux, plein, ravi, responsable, satisfait, surpris</td></tr><tr><td style='padding:0.5rem'>contre</td><td style='padding:0.5rem'>fâché, furieux (на человека)</td></tr><tr><td style='padding:0.5rem'>avec/envers</td><td style='padding:0.5rem'>aimable, brutal, gentil, poli</td></tr><tr><td style='padding:0.5rem'>pour/en</td><td style='padding:0.5rem'>doué, bon (в области)</td></tr></table><p style='margin:0.75rem 0;padding:0.6rem 0.8rem;border-left:3px solid #fbbf24;background:rgba(251,191,36,0.08)'>💡 Заучивайте с опорной фразой: fier DE son travail, fidèle À ses amis, fâché CONTRE son frère. Кнопка «⭐ В личный набор» — и в коуч.</p>"
    },
    {
      "id": "vb18-qz1",
      "type": "grammar-quiz",
      "title": "Прилагательные — тест-ловушка",
      "questions": [
        {
          "question": "Elle est très fière ___ ses enfants.",
          "options": [
            "de",
            "à",
            "pour",
            "avec"
          ],
          "correctAnswer": "de",
          "explanation": "Fier DE qch/qn."
        },
        {
          "question": "Il reste fidèle ___ ses principes.",
          "options": [
            "à",
            "de",
            "avec",
            "pour"
          ],
          "correctAnswer": "à",
          "explanation": "Fidèle À qch."
        },
        {
          "question": "Pourquoi es-tu fâché ___ moi ?",
          "options": [
            "contre",
            "avec",
            "sur",
            "de"
          ],
          "correctAnswer": "contre",
          "explanation": "Fâché CONTRE qn (норма; разг. встречается après, но учим contre)."
        },
        {
          "question": "Ma fille est douée ___ les langues.",
          "options": [
            "pour",
            "de",
            "à",
            "dans"
          ],
          "correctAnswer": "pour",
          "explanation": "Doué POUR (или en) — одарённый в области."
        },
        {
          "question": "Nous sommes impatients ___ vous revoir.",
          "options": [
            "de",
            "à",
            "pour",
            "en"
          ],
          "correctAnswer": "de",
          "explanation": "Impatient DE + infinitif."
        },
        {
          "question": "Ce quartier est très différent ___ centre-ville.",
          "options": [
            "du",
            "au",
            "que le",
            "avec le"
          ],
          "correctAnswer": "du",
          "explanation": "Différent DE: de + le = du."
        },
        {
          "question": "Je vous suis reconnaissante ___ votre soutien.",
          "options": [
            "de",
            "à",
            "pour à",
            "contre"
          ],
          "correctAnswer": "de",
          "explanation": "Reconnaissant À qn DE qch — благодарен (вам) за поддержку."
        },
        {
          "question": "Il est complètement accro ___ jeux vidéo.",
          "options": [
            "aux",
            "des",
            "les",
            "sur les"
          ],
          "correctAnswer": "aux",
          "explanation": "Accro À: à + les = aux jeux vidéo."
        }
      ]
    },
