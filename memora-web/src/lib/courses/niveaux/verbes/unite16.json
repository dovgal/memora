  "exercises": [
    {
      "id": "vb16-th1",
      "type": "theory",
      "title": "Lexique P–V: как заучивать",
      "content": "<p style='margin:0.75rem 0'>Это словарные юниты: оставшиеся глаголы справочника, у которых нет особого предложного управления. Их правило одно — система T/I из юнита 1: <b>T</b> — дополнение без предлога (кого? что?), <b>I</b> — без дополнения, <b>T/I</b> — употребляется обоими способами, «se…» — возвратный.</p><p style='margin:0.75rem 0'><b>Цикл:</b> «⭐ В личный набор» → карточки/заучивание → коуч повторяет по кривой забывания. Тест ниже — выборочная проверка переводов.</p><p style='margin:0.75rem 0;padding:0.6rem 0.8rem;border-left:3px solid #fbbf24;background:rgba(251,191,36,0.08)'>💡 Заучивая, проговаривайте мини-пример: не «casser», а «casser un verre» — разбить стакан.</p>"
    },
    {
      "id": "vb16-qz1",
      "type": "grammar-quiz",
      "title": "Выборочная проверка переводов (P–V)",
      "questions": [
        {
          "question": "«reprocher» означает…",
          "options": [
            "упрекать",
            "повторять",
            "чинить",
            "прятать"
          ],
          "correctAnswer": "упрекать",
          "explanation": "Reprocher (T): on me reproche mon retard."
        },
        {
          "question": "«заставать врасплох» — это…",
          "options": [
            "surprendre",
            "survenir",
            "sursauter",
            "supprimer"
          ],
          "correctAnswer": "surprendre",
          "explanation": "Surprendre (T): tu m'as surpris !"
        },
        {
          "question": "«se taire» означает…",
          "options": [
            "молчать",
            "стучать",
            "терпеть",
            "дрожать"
          ],
          "correctAnswer": "молчать",
          "explanation": "Taire (T) — умалчивать; se taire — замолчать: tais-toi !"
        },
        {
          "question": "«вздрагивать» — это…",
          "options": [
            "sursauter",
            "ruisseler",
            "trépigner",
            "sommeiller"
          ],
          "correctAnswer": "sursauter",
          "explanation": "Sursauter (I): j'ai sursauté au bruit."
        },
        {
          "question": "«verser» означает…",
          "options": [
            "наливать; платить",
            "проверять",
            "зеленеть",
            "отворачивать"
          ],
          "correctAnswer": "наливать; платить",
          "explanation": "Verser (T): verser du thé; verser un salaire."
        },
        {
          "question": "«иссякать» — это…",
          "options": [
            "tarir",
            "trier",
            "tordre",
            "tonner"
          ],
          "correctAnswer": "tarir",
          "explanation": "Tarir (I/T): la source a tari."
        }
      ]
    },
